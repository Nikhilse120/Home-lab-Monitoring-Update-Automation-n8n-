    {
      "parameters": {
        "jsCode": "const d = $input.first().json.data;\n\nconst cpuPct = Math.round(d.cpu * 100 * 10) / 10;\nconst memPct = Math.round((d.memory.used / d.memory.total) * 100 * 10) / 10;\nconst diskPct = Math.round((d.rootfs.used / d.rootfs.total) * 100 * 10) / 10;\n\nconst THRESHOLDS = { cpu: 85, mem: 85, disk: 80 };\n\nconst alerts = [];\nif (cpuPct > THRESHOLDS.cpu) alerts.push(`CPU: ${cpuPct}% (threshold ${THRESHOLDS.cpu}%)`);\nif (memPct > THRESHOLDS.mem) alerts.push(`Memory: ${memPct}% (threshold ${THRESHOLDS.mem}%)`);\nif (diskPct > THRESHOLDS.disk) alerts.push(`Disk: ${diskPct}% (threshold ${THRESHOLDS.disk}%)`);\n\nconst hasAlert = alerts.length > 0;\n\nreturn [{\n  json: {\n    cpuPct, memPct, diskPct,\n    uptime_hours: Math.round(d.uptime / 3600),\n    hasAlert,\n    message: hasAlert ? `⚠️ Proxmoxnik01 Resource Alert\\n\\n${alerts.join('\\n')}\\n\\nTime: ${new Date().toLocaleString()}` : ''\n  }\n}];"
      },
