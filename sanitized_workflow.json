    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Split by Type').item.json;\nconst stdout = $json.stdout || '';\nconst exitCode = $json.code;\nconst stderr = $json.stderr || '';\n\nconst checkFailed = exitCode !== 0 && exitCode !== undefined && exitCode !== null;\nconst lines = stdout.split('\\n').map(l => l.trim()).filter(l => l.length > 0);\n\nreturn {\n  json: {\n    ...original,\n    updateCount: checkFailed ? 0 : lines.length,\n    hasUpdate: checkFailed ? false : lines.length > 0,\n    checkFailed,\n    detail: checkFailed\n      ? `\\u26a0\\ufe0f CHECK FAILED (exit code ${exitCode}) - could not verify update status`\n      : (lines.length > 0 ? `${lines.length} package(s) available` : 'up to date'),\n    currentVersion: null,\n    latestVersion: null\n  }\n};"
      },
      "id": "78a69a67-d638-4a4b-9f69-4e54a897f60b",
      "name": "Parse APT Results",
      "type": "n8n-nodes-base.code",
