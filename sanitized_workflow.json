    {
      "parameters": {
        "command": "for d in $(lsblk -ndo NAME -e 7,11 | grep -v zram); do echo \"---DEVICE:/dev/$d---\"; smartctl -a -j /dev/$d 2>/dev/null; done"
      },
      "id": "a8750d27-b554-4933-a737-07c45f6ef486",
      "name": "Run smartctl (all drives)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        -656,
        400
      ],
      "credentials": {
        "sshPassword": {
          "id": "NvPF27ztmHBn9CsF",
          "name": "SSH Proxmox01 account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.stdout;\nconst blocks = raw.split('---DEVICE:').filter(b => b.trim().length > 0);\nconst results = [];\n\nfor (const block of blocks) {\n  const [devicePart, ...rest] = block.split('---');\n  const device = devicePart.trim();\n  const jsonPart = rest.join('---').trim();\n  let smart;\n  try { smart = JSON.parse(jsonPart); } catch (e) { continue; }\n  if (!smart || !smart.smart_status) continue;\n\n  const passed = smart.smart_status.passed;\n  const temp = smart.temperature ? smart.temperature.current : null;\n  const attrs = {};\n  if (smart.ata_smart_attributes && smart.ata_smart_attributes.table) {\n    for (const a of smart.ata_smart_attributes.table) attrs[a.name] = a.raw.value;\n  }\n  const reallocated = attrs['Reallocated_Sector_Ct'] || 0;\n  const pending = attrs['Current_Pending_Sector'] || 0;\n  const uncorrect = attrs['Reported_Uncorrect'] || 0;\n\n  const issues = [];\n  if (!passed) issues.push('SMART overall health: FAILED');\n  if (reallocated > 0) issues.push(`Reallocated sectors: ${reallocated}`);\n  if (pending > 0) issues.push(`Pending sectors: ${pending}`);\n  if (uncorrect > 0) issues.push(`Uncorrectable errors: ${uncorrect}`);\n  if (temp && temp > 55) issues.push(`Temperature: ${temp}°C`);\n\n  results.push({ device, passed, temp, reallocated, pending, uncorrect, hasIssue: issues.length > 0, issueText: issues.join(', ') });\n}\n\nconst flagged = results.filter(r => r.hasIssue);\nconst hasAlert = flagged.length > 0;\nconst message = hasAlert ? `🔴 Proxmoxnik01 SMART Alert\\n\\n` + flagged.map(f => `${f.device}: ${f.issueText}`).join('\\n') + `\\n\\nTime: ${new Date().toLocaleString()}` : '';\n\nreturn [{ json: { results, hasAlert, message, driveCount: results.length } }];"
      },
