      "id": "4544103d-32ed-4478-8347-0b79959f8c08",
      "name": "Send All-Clear Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1008,
        864
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst pending = items.filter(i => i.hasUpdate);\nconst failed = items.filter(i => i.checkFailed);\n\nif (pending.length === 0 && failed.length === 0) {\n  return [{ json: { hasUpdates: false, skip: true } }];\n}\n\nlet text = '\\ud83d\\udce6 Weekly Update Digest\\n\\n';\n\nif (failed.length > 0) {\n  text += failed.map(f => `\\u26a0\\ufe0f ${f.targetName}: ${f.detail}`).join('\\n') + '\\n\\n';\n}\n\nif (pending.length > 0) {\n  text += pending.map(p => `\\u2022 ${p.targetName}: ${p.detail}`).join('\\n') + '\\n\\nTap an item below to approve, or ignore to skip this week.';\n}\n\nconst inline_keyboard = pending.map(p => ([\n  { text: `\\u2705 Approve ${p.targetName}`, callback_data: `approve_${p.key}` },\n  { text: `\\u23ed Skip ${p.targetName}`, callback_data: `skip_${p.key}` }\n]));\n\nreturn [{ json: { hasUpdates: true, text, inline_keyboard } }];"
      },
