      "parameters": {
        "jsCode": "// EDIT THIS CONFIG to match your real LXCs and Docker apps.\n// Keep this list in sync with the identical config inside \"Parse Callback + Lookup Target\" below.\n// SCOPED DOWN for initial live test - only these 5 are active. Others (vaultwarden, Immichdocker, prowlarr, nginxproxymanager, notifiarr, homebridge, radarr, flaresolverr, Nextcloud) added back once verified.\n// IMPORTANT: verify each serviceName matches the actual systemd/docker service before approving any real update.\nconst TARGETS = [\n  { key: 'lxc_transmission', targetType: 'lxc', targetId: '104', targetName: 'transmission', serviceName: 'transmission-daemon' },\n  { key: 'lxc_sabnzbd', targetType: 'lxc', targetId: '107', targetName: 'sabnzbd', serviceName: 'sabnzbd' },\n  { key: 'lxc_sonarr', targetType: 'lxc', targetId: '116', targetName: 'sonarr', serviceName: 'sonarr' },\n  { key: 'lxc_jellyfin', targetType: 'lxc', targetId: '119', targetName: 'jellyfin', serviceName: 'jellyfin' },\n  { key: 'lxc_qbittorrent', targetType: 'lxc', targetId: '121', targetName: 'qbittorrent', serviceName: 'qbittorrent-nox' }\n];\n\nreturn TARGETS.map(t => ({ json: t }));"
