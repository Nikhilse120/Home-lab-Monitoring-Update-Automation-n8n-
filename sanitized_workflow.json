        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: \"YOUR_TELEGRAM_CHAT_ID\", text: \"\\u2705 Weekly check complete - all containers up to date, nothing to approve this week.\" }) }}",
        "options": {}
