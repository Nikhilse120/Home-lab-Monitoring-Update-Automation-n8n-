    {
      "parameters": {
        "jsCode": "// Keep this list in sync with \"Build Target List\" above. SCOPED to 5 for initial test.\nconst TARGETS = {\n  lxc_transmission: { targetType: 'lxc', targetId: '104', targetName: 'transmission', serviceName: 'transmission-daemon' },\n  lxc_sabnzbd: { targetType: 'lxc', targetId: '107', targetName: 'sabnzbd', serviceName: 'sabnzbd' },\n  lxc_sonarr: { targetType: 'lxc', targetId: '116', targetName: 'sonarr', serviceName: 'sonarr' },\n  lxc_jellyfin: { targetType: 'lxc', targetId: '119', targetName: 'jellyfin', serviceName: 'jellyfin' },\n  lxc_qbittorrent: { targetType: 'lxc', targetId: '121', targetName: 'qbittorrent', serviceName: 'qbittorrent-nox' }\n};\n\nconst data = $json.callback_query.data; // e.g. \"approve_lxc_vaultwarden\" or \"skip_docker_frigate\"\nconst callbackQueryId = $json.callback_query.id;\nconst chatId = $json.callback_query.message.chat.id;\n\nconst action = data.startsWith('approve_') ? 'approve' : 'skip';\nconst key = data.replace(/^(approve_|skip_)/, '');\nconst target = TARGETS[key] || {};\n\nreturn [{ json: { action, key, chatId, callbackQueryId, ...target } }];"
      },
      "id": "679a443a-3065-4ce1-b6ac-1f00aa1109c9",
      "name": "Parse Callback + Lookup Target",
