      "id": "69fa96a2-8f9d-4257-9b22-1135413403cb",
      "name": "Approve or Skip?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        -448,
        1072
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $json;\nconst now = new Date();\nconst dateTag = now.toISOString().slice(0,10).replace(/-/g,'') + '-' + now.toTimeString().slice(0,8).replace(/:/g,'');\nconst vmid = item.targetType === 'lxc' ? item.targetId : item.hostLxcId;\n\nlet applyCmd, healthCmd;\nif (item.targetType === 'lxc') {\n  applyCmd = `pct exec ${vmid} -- bash -c \\\"apt-get update -qq && apt-get upgrade -y\\\"`;\n  healthCmd = `pct exec ${vmid} -- systemctl is-active ${item.serviceName}`;\n} else {\n  applyCmd = `pct exec ${vmid} -- bash -c \\\"cd ${item.composeDir} && docker compose pull && docker compose up -d\\\"`;\n  healthCmd = `pct exec ${vmid} -- bash -c \\\"curl -s -o /dev/null -w '%{http_code}' ${item.healthUrl}\\\"`;\n}\n\n// No pre-update backup taken - relies on the existing nightly PBS backup job.\n// If rollback is needed, restore the most recent existing backup for this vmid.\nconst restoreCmd = `LATEST=$(pvesm list Central-Backup-Repo | grep \\\"ct/${vmid}/\\\" | tail -1 | awk '{print $1}'); pct restore ${vmid} $LATEST --storage storage --force`;\n\nreturn { json: { ...item, vmid, dateTag, applyCmd, healthCmd, rollbackCmd: restoreCmd } };"
