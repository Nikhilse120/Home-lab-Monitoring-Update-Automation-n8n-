    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Split by Type').item.json;\nconst results = $json.results || [];\nconst latest = results.length > 0 ? results[0].name : null;\n\nconst hasUpdate = latest && latest !== original.currentVersion;\n\nreturn {\n  json: {\n    ...original,\n    updateCount: hasUpdate ? 1 : 0,\n    hasUpdate,\n    detail: hasUpdate ? `${original.currentVersion} -> ${latest}` : 'up to date',\n    latestVersion: latest\n  }\n};"
      },
